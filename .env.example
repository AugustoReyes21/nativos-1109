# Copy to .env locally; generate independent random values. Never commit secrets.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://nativos:local_only@127.0.0.1:55432/nativos
DATABASE_SSL=false
JWT_SECRET=
MFA_KEY=
# Set only for one-time db:bootstrap, remove immediately afterward.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
# Required for password recovery delivery; never returned in API responses.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Restaurant public IP(s), comma-separated. Exempt from the per-account login cap.
TRUSTED_LOGIN_IPS=
